  {
    "chapter": 4,
    "verse": 14,
    "text": "ⲟⲩϣⲁⲗ ⲛⲉⲙ ⲟⲩⲁⲗⲗⲱⲓ ⲛⲉⲙ ⲛ̀ϩⲏⲛⲓ ⲧⲏⲣⲟⲩ ⲉⲧⲥⲱⲧⲡ"
  },
  {
    "chapter": 4,
    "verse": 15,
    "text": "ⲉⲩⲟⲓ ⲛ̀ⲑⲏ ⲛ̀ⲟⲩⲡⲓⲅⲏ ⲛ̀ⲕⲁⲣⲡⲟⲥ ⲟⲩⲟϩ ⲟⲩϣⲱϯ ⲙ̀ⲙⲱⲟⲩ ⲉϥϣⲟⲩⲟ ⲉ̀ⲃⲟⲗ ϧⲉⲛ ⲡⲓⲗⲓⲃⲁⲛⲟⲥ"
  },
  {
    "chapter": 4,
    "verse": 16,
    "text": "ⲧⲱⲟⲩⲛ ⲡⲉⲙϩⲓⲧ ⲁⲙⲟⲩ ⲉ̀ⲡⲧⲟⲩⲣⲏⲥ ⲛⲉⲅⲛⲓϥⲓ ⲉ̀ϧⲟⲩⲛ ϧⲉⲛ ⲡⲁⲓⲕⲩⲡⲟⲥ ⲛⲧⲉ ⲛⲁϩⲏⲛⲉ ϯ ⲛ̀ⲛⲉⲩⲥⲧⲟⲓ"
  },
  {
    "chapter": 5,
    "verse": 1,
    "text": "ⲙⲁⲣⲉ ⲡⲁⲥⲟⲛ ⲃⲱⲕ ⲉ̀ϩⲣⲏⲓ ⲉ̀ⲡⲉϥⲕⲩⲡⲟⲥ ⲛⲉϥⲟⲩⲱⲙ ⲛⲉⲙ ⲕⲁⲣⲡⲟⲥ ⲛⲉⲛϣⲏⲛ ⲁⲓⲃⲱⲕ ⲉ̀ϧⲟⲩⲛ ⲉ̀ⲡⲁⲩⲕⲩⲡⲟⲥ ⲧⲁⲥⲱⲛⲓ ⲧⲁϣⲉⲗⲉⲧ ⲧⲁϫⲱⲗⲓ ⲙ̀ⲡⲁϣⲁⲗ ⲛⲉⲙ ⲡⲁϣⲟⲩϩⲏⲛⲓ ⲁⲓⲟⲩⲱⲙ ⲙⲡ̀ⲁⲱⲓⲕ ⲛⲉⲙ ⲡⲁⲉⲃⲓⲱ ⲁⲓⲥⲱ ⲙ̀ⲡⲁⲏⲣⲡ ⲛⲉⲙ ⲡⲁⲉⲣⲱϯ ⲟⲩⲱⲙ ϩⲱⲧ ⲧⲏⲟⲩⲧⲉⲛ ⲛⲁϣⲫⲏⲣ ⲛ̀ⲧⲉⲧⲉⲛⲥⲓ ⲛ̀ⲧⲉⲧⲉⲛϯϩⲉ ⲛⲁⲥⲛⲏⲟⲩ"
  },
  {
    "chapter": 5,
    "verse": 2,
    "text": "ⲁ̀ⲛⲟⲕ ϯⲱⲃϣ ⲟⲩⲟϩ ⲡⲁϩⲏⲧ ⲣⲏⲥ ⲓⲥ ⲡⲉϧⲣⲱⲟⲩ ⲙ̀ⲡⲁⲥⲟⲛ ⲉϥⲧⲱϩⲉⲙ ⲉ̀ⲫⲣⲟ ϫⲉ ⲁⲟⲩⲱⲛ ⲛⲁⲛ ⲧⲁⲥⲱⲛⲓ ⲧⲁϣⲉⲗⲏⲧ ⲧⲁϫⲟⲙ ⲡⲉ ⲉⲧϫⲏⲕ ⲉⲃⲟⲗ ϫⲉ ⲉⲧⲁ ⲁⲫⲉ ⲙⲟⲩϩ ⲛⲓⲱϯ ⲟⲩⲟϩ ⲁ ⲡⲁⲃⲱ ⲧⲟⲗⲉⲙ ⲁϥⲙⲟⲩϩ ⲛ̀ϫⲁϥ"
  },
  {
    "chapter": 5,
    "verse": 3,
    "text": "ⲁⲓⲕⲁⲧⲕⲁϩⲏⲟⲩ ⲛ̀ⲧⲁϣⲧⲉⲛ ⲛ̀ϫⲱⲣϩ ⲉⲓⲛⲁⲧⲁⲁⲥ ϩⲓⲱⲧⲱⲛ ⲛ̀ⲁϣ ⲛ̀ϩⲉ ⲁⲓⲉⲓⲱ ⲛⲁⲟⲩⲁⲣⲉⲧⲏ ⲉⲓⲛⲁⲧⲟⲗⲙⲟⲩ ⲟⲛ ⲛ̀ⲁϣ ⲛ̀ϩⲉ"
  },
  {
    "chapter": 5,
    "verse": 4,
    "text": "ⲡⲁⲥⲟⲛ ⲁϥϫⲉⲩ ⲛ̀ⲧⲟⲧϥ ⲉ̀ϧⲟⲩⲛ ϧⲉⲛ ⲡⲟⲩⲱϣ ⲙ̀ⲡⲓⲣⲟ ⲟⲩⲟϩ ⲁ ⲡⲁϩⲏⲧ ϣⲑⲟⲣⲧⲉⲣ ⲛ̀ⲥⲱϥ"
  },
  {
    "chapter": 5,
    "verse": 5,
    "text": "ⲁⲓⲧⲱⲟⲩⲛ ⲁ̀ⲛⲟⲕ ⲉⲧⲣⲁⲟⲩⲱⲛ ⲙ̀ⲡⲁⲥⲟⲛ ⲟⲩⲟϩ ⲁ ⲛⲁϫⲓϫ ⲧⲁⲩⲉ ϣⲁⲗ ⲉ̀ⲡⲉⲥⲏⲧ ⲛⲁⲧⲏⲃⲓ ⲁⲩⲧⲁⲩⲉ ϣⲁⲗ ⲉϥⲥⲟⲧⲡ ⲉ̀ⲃⲟⲗ"
  },
  {
    "chapter": 5,
    "verse": 6,
    "text": "ⲁⲓⲟⲩⲱⲛ ⲙ̀ⲡⲁⲥⲟⲛ ⲟⲩⲟϩ ⲁϥⲥⲁⲁⲧ ⲁⲓⲕⲱϯ ⲛ̀ⲥⲱϥ ⲟⲩⲟϩ ⲙ̀ⲡⲓϩⲉ ⲉ̀ⲣⲟϥ"
  },
  {
    "chapter": 5,
    "verse": 7,
    "text": "ⲁⲩϩⲉ ⲉ̀ⲣⲟⲓ ⲛ̀ϫⲉ ⲛⲉⲧⲣⲱⲓⲥ ϧⲉⲛ ⲧⲡⲟⲗⲓⲥ ⲁⲩⲕⲱϯ ⲉ̀ⲣⲟⲥ ⲁⲩⲣⲁϧⲧ ⲁⲩⲡⲗⲁⲅⲏ ⲙ̀ⲙⲟⲓ ⲁⲩϥⲓ ⲙ̀ⲡⲁⲉⲣϣⲱⲛ ⲛ̀ⲧⲟⲧ ⲛ̀ϫⲉ ⲛⲉⲧⲣⲱⲓⲥ ⲛ̀ⲥⲟⲃⲧ"
  },
  {
    "chapter": 5,
    "verse": 8,
    "text": "ⲁⲓⲧⲁⲣⲉⲕ ⲧⲏⲟⲩⲧⲉⲛ ⲛ̀ϣⲉⲣⲓ ⲛ̀ⲓⲉⲣⲟⲩⲥⲁⲗⲏⲙ ϧⲉⲛ ⲛ̀ϫⲟⲙ ⲟⲩⲟϩ ϧⲉⲛ ⲛ̀ⲛⲟⲙϯ ⲛ̀ⲧⲥⲱϣⲓ ϫⲉ ⲁⲧⲉⲧⲉⲛϣⲁⲛϩⲉ ⲉ̀ⲡⲁⲥⲟⲛ ⲟⲩ ⲡⲉ ⲧⲉⲧⲉⲛⲛⲁϫⲟϥ ⲛⲁϥ"
  },
  {
    "chapter": 5,
    "verse": 9,
    "text": "ⲙⲁⲧⲁⲙⲟⲛ ϫⲉ ⲟⲩ ⲁϣ ⲙ̀ⲙⲓⲛ ⲡⲉ ⲡⲟⲩⲥⲟⲛ ⲱ ⲧⲉⲧⲉⲛⲓⲥⲱⲥ ϧⲉⲛ ⲛⲓϩⲓⲟⲙⲓ"
  },
  {
    "chapter": 5,
    "verse": 10,
    "text": "ⲡⲉⲥⲙⲟⲧ ⲙ̀ⲡⲁⲥⲟⲛ ⲡⲉ ⲉϥⲉ̀ⲑⲣⲉϣⲣⲱϣ ⲁϥⲣⲉϩⲉ ⲧⲏⲣϥ ⲉⲣⲉ ⲛⲉϥϩⲟⲓϯ ⲟⲛⲓ ⲥⲑⲟⲓⲛⲟⲩϥⲓ ϧⲉⲛ ⲟⲩϣⲁⲗ ⲛⲉⲙ ⲟⲩⲗⲓⲃⲁⲛⲟⲥ ⲉ̀ⲃⲟⲗ ϧⲉⲛ ⲛ̀ϩⲏⲛⲓ ⲧⲏⲣⲟⲩ ⲛ̀ⲣⲉϥⲡⲓⲉⲥⲱϫⲉⲛ"
  },
