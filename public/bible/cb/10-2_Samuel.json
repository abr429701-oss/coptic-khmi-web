  {
    "chapter": 6,
    "verse": 1,
    "text": "Ⲟⲩⲟϩ ⲁ ⲇⲁⲩⲓⲇ ⲑⲱⲟⲩϯ ⲛ̀ϧⲉⲗϣⲓⲣⲓ ⲛⲓⲃⲉⲛ ⲛ̀ⲧⲉ ⲡⲓⲥ̅ⲗ̅ ⲉⲩⲉⲣϣⲃⲉ ⲛ̀ϣⲟ"
  },
  {
    "chapter": 6,
    "verse": 2,
    "text": "Ⲟⲩⲟϩ ⲁϥⲧⲱⲛϥ ⲛ̀ϫⲉ ⲇⲁⲩⲓⲇ ⲁϥϣⲉ ⲛⲁϥ ⲛⲉⲙ ⲡⲓⲗⲁⲟⲥ ⲧⲏⲣϥ ⲉⲑⲛⲉⲙⲁϥ ⲛⲉⲙ ⲉ̀ⲃⲟⲗ ϧⲉⲛ ⲛⲓⲁⲣⲭⲱⲛ ⲛ̀ⲧⲉ ⲓⲟⲩⲇⲁ ϩⲓ ⲡⲓⲙⲱⲓⲧ ⲉ̀ⲡϣⲱⲓ ϫⲉ ⲛ̀ⲧⲟⲩⲓⲛⲓ ⲛ̀ϯⲕⲓⲃⲱⲧⲟⲥ ⲛ̀ⲧⲉ ⲫϯ ⲉ̀ⲡϣⲱⲓ ⲉ̀ⲃⲟⲗ ⲙ̀ⲙⲁⲩ ⲑⲏ ⲉⲧⲟⲩⲙⲟⲩϯ ⲉ̀ϫⲱⲥ ⲙ̀ⲫⲣⲁⲛ ⲙ̀ⲡ⳪̅ ⲛ̀ⲧⲉ ⲛⲓϫⲟⲙ ⲉϥϩⲉⲙⲥⲓ ϩⲓϫⲉⲛ ⲛⲓⲭⲉⲣⲟⲩⲃⲓⲙ ⲉⲧⲭⲏ ϩⲓϫⲱⲥ"
  },
  {
    "chapter": 6,
    "verse": 3,
    "text": "Ⲟⲩⲟϩ ⲁⲩⲧⲁⲗⲟ ⲛ̀ϯⲕⲓⲃⲱⲧⲟⲥ ⲛ̀ⲧⲉ ⲡ⳪̅ ⲉ̀ⲟⲩⲙⲃⲣⲉϩⲓ ⲙ̀ⲃⲉⲣⲓ ⲁⲩⲟⲗⲥ ⲉ̀ⲃⲟⲗ ϧⲉⲛ ⲡⲏⲓ ⲛ̀ⲁⲙⲓⲛⲁⲇⲁⲃ ⲫⲏ ⲉⲧⲭⲏ ϧⲉⲛ ϯⲕⲁⲗⲁⲙⲫⲟ ⲟⲩⲟϩ ⲟⲍⲁ ⲛⲉⲙ ⲛⲉϥⲥⲛⲏⲟⲩ ⲛⲉⲛϣⲏⲣⲓ ⲛ̀ⲁⲙⲓⲛⲁⲇⲁⲃ ⲛⲁⲩⲓⲛⲓ ⲙ̀ⲡⲓⲙⲃⲣⲉϩⲓ"
  },
  {
    "chapter": 6,
    "verse": 4,
    "text": "Ⲛⲉⲙ ϯⲕⲓⲃⲱⲧⲟⲥ ⲟⲩⲟϩ ⲛⲉϥⲥⲛⲏⲟⲩ ⲛⲁⲩⲙⲟϣⲓ ϧⲁϫⲱⲥ ⲛ̀ϯⲕⲓⲃⲱⲧⲟⲥ"
  },
  {
    "chapter": 6,
    "verse": 5,
    "text": "Ⲟⲩⲟϩ ⲇⲁⲩⲓⲇ ⲛⲉⲙ ⲛⲉⲛϣⲏⲣⲓ ⲙ̀ⲡⲓⲥ̅ⲗ̅ ⲛⲁⲩⲥⲱⲃⲓ ⲙ̀ⲡⲉⲙ̀ⲑⲟ ⲙ̀ⲡ⳪̅ ϧⲉⲛ ϩⲁⲛⲟⲣⲅⲁⲛⲟⲛ ⲉⲩϩⲱⲧⲡ ϧⲉⲛ ⲟⲩϫⲟⲙ ⲛⲉⲙ ϩⲁⲛϩⲱⲇⲏ ⲛⲉⲙ ϩⲁⲛⲕⲩⲑⲁⲣⲁ ⲛⲉⲙ ϩⲁⲛⲛⲁⲃⲗⲁ ⲛⲉⲙ ϩⲁⲛⲕⲉⲙⲕⲉⲙ ⲛⲉⲙ ϩⲁⲛⲕⲩⲙⲃⲁⲗⲟⲛ ⲛⲉⲙ ϩⲁⲛⲥⲏⲃⲓ ⲛ̀ϫⲱ"
  },
  {
    "chapter": 6,
    "verse": 6,
    "text": "Ⲟⲩⲟϩ ⲁⲩⲓ̀ ϣⲁ ⲡⲓϭⲛⲱⲟⲩ ⲛ̀ⲧⲉ ⲛⲁⲭⲱⲣ ⲟⲩⲟϩ ⲁϥⲥⲟⲩⲧⲉⲛ ⲧⲉϥϫⲓϫ ⲉ̀ⲃⲟⲗ ⲛ̀ϫⲉ ⲟⲍⲁ ⲉ̀ϯⲕⲓⲃⲱⲧⲟⲥ ⲛ̀ⲧⲉ ⲫϯ ⲉ̀ⲧⲁϩⲛⲟ ⲙ̀ⲙⲟⲥ ⲟⲩⲟϩ ⲁϥⲁⲙⲟⲛⲓ ⲙ̀ⲙⲟⲥ ϫⲉ ⲛⲉ ⲁϥϯϭⲗⲁϩ ⲛⲁⲥ ⲡⲉ ⲛ̀ϫⲉ ⲡⲓⲙⲁⲥⲓ"
  },
  {
    "chapter": 6,
    "verse": 7,
    "text": "Ⲟⲩⲟϩ ⲁϥⲙⲃⲟⲛ ϧⲉⲛ ⲟⲩϫⲱⲛⲧ ⲛ̀ϫⲉ ⲡ⳪̅ ⲉ̀ⲟⲍⲁ ⲟⲩⲟϩ ⲁϥⲣⲁϧⲧ ⲙ̀ⲙⲟϥ ⲙ̀ⲙⲁⲩ ⲛ̀ϫⲉ ⲡ⳪̅ ⲟⲩⲟϩ ⲁϥⲙⲟⲩ ⲙ̀ⲙⲁⲩ ϧⲁⲧⲉⲛ ϯⲕⲓⲃⲱⲧⲟⲥ ⲛ̀ⲧⲉ ⲡ⳪̅ ⲙ̀ⲡⲉⲙ̀ⲑⲟ ⲙ̀ⲫϯ"
  },
  {
    "chapter": 6,
    "verse": 8,
    "text": "Ⲟⲩⲟϩ ⲁϥⲉⲣⲙⲕⲁϩ ⲛ̀ϩⲏⲧ ⲛ̀ϫⲉ ⲇⲁⲩⲓⲇ ϫⲉ ϧⲉⲛ ⲟⲩϣⲱⲧ ⲉ̀ⲃⲟⲗ ⲁ ⲡ⳪̅ ϥⲱϯ ⲉ̀ⲃⲟⲗ ⲛ̀ⲟⲍⲁ ⲟⲩⲟϩ ⲁⲩⲙⲟⲩϯ ⲉ̀ⲡⲓⲙⲁ ⲉⲧⲉⲙ̀ⲙⲁⲩ ϫⲉ ⲡⲓϥⲱϯ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲟⲍⲁ ϣⲁ ⲉ̀ϧⲟⲩⲛ ⲉ̀ⲫⲟⲟⲩ ⲛ̀ⲉϩⲟⲟⲩ ⲫⲁⲓ"
  },
  {
    "chapter": 6,
    "verse": 9,
    "text": "Ⲟⲩⲟϩ ⲁϥⲉⲣϩⲟϯ ⲛ̀ϫⲉ ⲇⲁⲩⲓⲇ ϧⲁⲧϩⲏ ⲙ̀ⲡ⳪̅ ϧⲉⲛ ⲡⲓⲉϩⲟⲟⲩ ⲉⲧⲉⲙ̀ⲙⲁⲩ ⲉϥϫⲱ ⲙ̀ⲙⲟⲥ ϫⲉ ⲡⲱⲥ ϥⲛⲁⲓ ⲉ̀ϧⲟⲩⲛ ⲉ̀ⲡⲁⲏⲓ ⲛ̀ϫⲉ ϯⲕⲓⲃⲱⲧⲟⲥ ⲛ̀ⲧⲉ ⲡ⳪̅"
  },
  {
    "chapter": 6,
    "verse": 10,
    "text": "Ⲟⲩⲟϩ ⲛⲁϥⲟⲩⲱϣ ⲁⲛ ⲡⲉ ⲛ̀ϫⲉ ⲇⲁⲩⲓⲇ ⲉ̀ⲑⲣⲉⲥⲣⲓⲕⲓ ⲛⲁϩⲣⲁϥ ⲛ̀ϫⲉ ϯⲕⲓⲃⲱⲧⲟⲥ ⲛ̀ⲧⲉ ϯⲇⲓⲁⲑⲏⲕⲏ ⲛ̀ⲧⲉ ⲡ⳪̅ ⲉ̀ϧⲟⲩⲛ ⲉ̀ⲑⲃⲁⲕⲓ ⲛ̀ⲧⲉ ⲇⲁⲩⲓⲇ ⲟⲩⲟϩ ⲁϥⲑⲣⲉⲥⲣⲓⲕⲓ ⲛ̀ϫⲉ ⲇⲁⲩⲓⲇ ⲉϧⲟⲩⲛ ⲉ̀ⲡⲏⲓ ⲛ̀ⲁⲃⲉⲇⲇⲁⲣⲁ ⲡⲓⲅⲉⲑⲉⲟⲥ"
  },
  {
    "chapter": 6,
    "verse": 11,
    "text": "Ⲟⲩⲟϩ ⲁⲥϩⲉⲙⲥⲓ ⲛ̀ϫⲉ ϯⲕⲓⲃⲱⲧⲟⲥ ⲛ̀ⲧⲉ ⲡ⳪̅ ϧⲉⲛ ⲡⲏⲓ ⲛ̀ⲁⲃⲉⲇⲇⲁⲣⲁ ⲡⲓⲅⲉⲑⲉⲟⲥ ⲅ̅ ⲛ̀ⲁⲃⲟⲧ ⲟⲩⲟϩ ⲁ ⲡ⳪̅ ⲥⲙⲟⲩ ⲉ̀ⲡⲏⲓ ⲛ̀ⲁⲃⲉⲇⲇⲁⲣⲁ ⲛⲉⲙ ⲛⲏ ⲉⲧⲉ ⲛ̀ⲧⲁϥ ⲧⲏⲣⲟⲩ ⲉⲑⲃⲉ ϯⲕⲓⲃⲱⲧⲟⲥ ⲛ̀ⲧⲉ ⲡ⳪̅"
  },
  {
    "chapter": 6,
    "verse": 12,
    "text": "Ⲟⲩⲟϩ ⲁⲩⲧⲁⲙⲉ ⲡⲟⲩⲣⲟ ⲉⲩϫⲱ ⲙ̀ⲙⲟⲥ ϫⲉ ⲁ ⲡ⳪̅ ⲉ̀ⲡⲏⲓ ⲛ̀ⲁⲃⲉⲇⲇⲁⲣⲁ ⲛⲉⲙ ⲛⲏ ⲉⲧⲉⲛ̀ⲧⲁϥ ⲧⲏⲣⲟⲩ ⲉⲑⲃⲉ ϯⲕⲓⲃⲱⲧⲟⲥ ⲛ̀ⲧⲉ ϯⲇⲓⲁⲑⲏⲕⲏ ⲛ̀ⲧⲉ ⲡ⳪̅ ⲟⲩⲟϩ ⲁϥϣⲉ ⲛⲁϥ ⲛ̀ϫⲉ ⲇⲁⲩⲓⲇ ⲁϥⲓⲛⲓ ⲉ̀ⲡϣⲱⲓ ⲛϯⲕⲓⲃⲱⲧⲟⲥ ⲛ̀ⲧⲉ ⲡ⳪̅ ⲉ̀ⲃⲟⲗ ϧⲉⲛ ⲡⲏⲓ ⲛ̀ⲁⲃⲉⲇⲇⲁⲣⲁ ⲉ̀ϧⲟⲩⲛ ⲉ̀ⲑⲃⲁⲕⲓ ⲛ̀ⲇⲁⲩⲓⲇ ϧⲉⲛ ⲟⲩⲟⲩⲛⲟϥ ⲛⲉⲙ ⲟⲩⲑⲉⲗⲏⲗ"
  },
  {
    "chapter": 6,
    "verse": 13,
    "text": "Ⲟⲩⲟϩ ⲛⲁⲩⲭⲏ ⲛⲉⲙⲱⲟⲩ ⲡⲉ ⲉⲩⲱⲗⲓ ⲛ̀ϯⲕⲓⲃⲱⲧⲟⲥ ⲛ̀ⲧⲉ ⲡ⳪̅ ⲛ̀ϫⲉ ⲍ̅ ⲛ̀ⲭⲟⲣⲟⲥ ⲛⲉⲙ ϩⲁⲛϣⲟⲩϣⲱⲟⲩϣⲓ ⲕ̅ ⲙ̀ⲙⲁⲥⲓ ⲛⲉⲙ ϩⲁⲛϩⲓⲏⲃ"
  },
  {
    "chapter": 6,
    "verse": 14,
    "text": "Ⲟⲩⲟϩ ⲇⲁⲩⲓⲇ ⲛⲁϥⲕⲱⲗϩ ϧⲉⲛ ϩⲁⲛⲟⲣⲅⲁⲛⲟⲛ ⲉⲩϩⲱⲧⲡ ⲙ̀ⲡⲉⲙ̀ⲑⲟ ⲙ̀ⲡ⳪̅ ⲟⲩⲟϩ ⲛⲉ ⲟⲩⲟⲛ ⲥⲧⲟⲗⲏ ⲧⲟⲓ ϩⲓⲱⲧϥ ⲛ̀ⲇⲁⲩⲓⲇ ⲉⲥⲟⲓ ⲛ̀ⲁⲟⲩⲓⲁⲟⲩⲁⲛ"
  },
  {
    "chapter": 6,
    "verse": 15,
    "text": "Ⲟⲩⲟϩ ⲇⲁⲩⲓⲇ ⲛⲉⲙ ⲡⲏⲓ ⲧⲏⲣϥ ⲙ̀ⲡⲓⲥ̅ⲗ̅ ⲁⲩⲓⲛⲓ ⲉ̀ⲡϣⲱⲓ ⲛ̀ϯⲕⲓⲃⲱⲧⲟⲥ ⲛ̀ⲧⲉ ⲡ⳪̅ ϧⲉⲛ ⲟⲩϧⲣⲱⲟⲩ ⲛⲉⲙ ⲟⲩⲥⲙⲏ ⲛ̀ⲥⲁⲗⲡⲓⲅⲅⲟⲥ"
  },
  {
    "chapter": 6,
    "verse": 16,
    "text": "Ⲟⲩⲟϩ ⲁⲥϣⲱⲡⲓ ⲉⲧⲁⲥⲓ̀ ⲉ̀ⲡϣⲱⲓ ⲛ̀ϫⲉ ϯⲕⲓⲃⲱⲧⲟⲥ ⲛ̀ⲧⲉ ⲡ⳪̅ ⲉ̀ⲑⲃⲁⲕⲓ ⲛ̀ⲇⲁⲩⲓⲇ ⲟⲩⲟϩ ⲁ ⲙⲉⲗⲭⲟⲗ ⲧϣⲉⲣⲓ ⲛ̀ⲥⲁⲟⲩⲗ ϫⲟⲩϣⲧ ⲉ̀ⲃⲟⲗ ϧⲉⲛ ϯϣⲟⲩϣⲧ ⲁⲥⲛⲁⲩ ⲉ̀ⲡⲟⲩⲣⲟ ⲇⲁⲩⲓⲇ ⲉϥϭⲟⲥϫⲉⲥ ⲟⲩⲟϩ ⲉϥⲉⲣⲕⲱⲗϩ ⲛ̀ϫⲓϫ ⲙ̀ⲡⲉⲙ̀ⲑⲟ ⲙ̀ⲡ⳪̅ ⲟⲩⲟϩ ⲁⲥϣⲟϣϥϥ ϧⲉⲛ ⲡⲉⲥϩⲏⲧ"
  },
  {
    "chapter": 6,
    "verse": 17,
    "text": "Ⲟⲩⲟϩ ⲁⲩⲓⲛⲓ ⲛ̀ϯⲕⲓⲃⲱⲧⲟⲥ ⲛ̀ⲧⲉ ⲡ⳪̅ ⲉ̀ϧⲟⲩⲛ ⲁⲩⲭⲁⲥ ϧⲉⲛ ⲡⲉⲥⲙⲁ ϧⲉⲛ ϯⲥⲕⲏⲛⲏ ⲑⲏ ⲉⲧⲁϥⲧⲁϫⲣⲟⲥ ⲛⲁⲥ ⲛ̀ϫⲉ ⲇⲁⲩⲓⲇ ⲟⲩⲟϩ ⲁ ⲇⲁⲩⲓⲇ ⲓⲛⲓ ⲛ̀ϩⲁⲛϭⲗⲓⲗ ⲉ̀ϩⲣⲏⲓ ⲛⲉⲙ ϩⲁⲛϩⲓⲣⲏⲛⲏⲕⲟⲛ ⲙ̀ⲡⲉⲙ̀ⲑⲟ ⲙ̀ⲡ⳪̅"
  },
  {
    "chapter": 6,
    "verse": 18,
    "text": "Ⲟⲩⲟϩ ⲉⲧⲁϥⲟⲩⲱ ⲛ̀ϫⲉ ⲇⲁⲩⲓⲇ ⲉϥⲓⲛⲓ ⲉ̀ϩⲣⲏⲓ ⲛ̀ϩⲁⲛϭⲗⲓⲗ ⲛⲉⲙ ϩⲁⲛϩⲓⲣⲏⲛⲏⲕⲟⲛ ⲁϥⲥⲙⲟⲩ ⲉ̀ⲡⲓⲗⲁⲟⲥ ϧⲉⲛ ⲫⲣⲁⲛ ⲙ̀ⲡ⳪̅ ⲛ̀ⲧⲉ ⲛⲓϫⲟⲙ"
  },
  {
    "chapter": 6,
    "verse": 19,
    "text": "Ⲟⲩⲟϩ ⲁϥⲫⲱϣ ⲙ̀ⲡⲓⲗⲁⲟⲥ ⲧⲏⲣϥ ϧⲉⲛ ϯϫⲟⲙ ⲧⲏⲣⲥ ⲛ̀ⲧⲉ ⲡⲓⲥ̅ⲗ̅ ⲓⲥϫⲉⲛ ⲇⲁⲛ ϣⲁ ⲃⲏⲣⲥⲁⲃⲉⲉ ⲓⲥϫⲉⲛ ⲟⲩⲣⲱⲙⲓ ϣⲁ ⲟⲩⲥϩⲓⲙⲓ ⲁϥϯ ⲛ̀ⲟⲩⲕⲟⲗⲗⲩⲣⲓⲥ ⲛ̀ⲱⲓⲕ ⲙ̀ⲡⲓⲟⲩⲁⲓ ⲡⲓⲟⲩⲁⲓ ⲙ̀ⲙⲱⲟⲩ ⲛⲉⲙ ⲟⲩⲉⲥⲭⲁⲣⲓⲧⲏⲥ ⲛⲉⲙ ⲟⲩϫⲟⲗ ⲛ̀ⲗⲁⲕⲉⲛⲧ ⲟⲩⲟϩ ⲁϥϣⲉ ⲛⲁϥ ⲛ̀ϫⲉ ⲡⲓⲗⲁⲟⲥ ⲧⲏⲣϥ ⲡⲓⲟⲩⲁⲓ ⲡⲓⲟⲩⲁⲓ ⲉ̀ϧⲟⲩⲛ ⲉ̀ⲡⲉϥⲏⲓ"
  },
  {
    "chapter": 6,
    "verse": 20,
    "text": "Ⲟⲩⲟϩ ⲁϥⲧⲁⲥⲑⲟ ⲛ̀ϫⲉ ⲇⲁⲩⲓⲇ ⲉ̀ⲥⲙⲟⲩ ⲉ̀ⲡⲉϥⲏⲓ"
  },
