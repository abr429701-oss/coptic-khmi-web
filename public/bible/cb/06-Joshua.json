  {
    "chapter": 3,
    "verse": 7,
    "text": "Ⲟⲩⲟϩ ⲡⲉϫⲉ ⲡ⳪̅ ⲛ̀ⲓⲏⲥⲟⲩ ϫⲉ ϧⲉⲛ ⲫⲟⲟⲩ ⲛ̀ⲉϩⲟⲟⲩ ϯⲛⲁⲉⲣϩⲏⲧⲥ ⲛ̀ϭⲓⲥⲓ ⲙ̀ⲙⲟⲕ ⲙ̀ⲡⲉⲙ̀ⲑⲟ ⲛ̀ⲛⲉⲛϣⲏⲣⲓ ⲙ̀ⲡⲓⲥ̅ⲗ̅ ⲧⲏⲣⲟⲩ ϫⲉ ϩⲓⲛⲁ ⲉⲩⲉ̀ⲉⲙⲓ ϫⲉ ⲕⲁⲧⲁ ⲫⲣⲏϯ ⲉⲧⲁⲓϣⲱⲡⲓ ⲛⲉⲙ ⲙⲱⲩ̀ⲥⲏⲥ ⲡⲁⲓⲣⲏϯ ϯⲛⲁϣⲱⲡⲓ ⲛⲉⲙⲁⲕ ϩⲱⲕ"
  },
  {
    "chapter": 3,
    "verse": 8,
    "text": "Ⲟⲩⲟϩ ϯⲛⲟⲩ ϩⲟⲛϩⲉⲛ ⲛ̀ⲛⲓⲟⲩⲏⲃ ⲉⲑⲃⲉ ϯⲕⲩⲃⲱⲧⲟⲥ ⲛ̀ⲧⲉ ϯⲇⲓⲁⲑⲏⲕⲏ ⲉⲕϫⲱ ⲙ̀ⲙⲟⲥ ⲛⲱⲟⲩ ϫⲉ ⲁⲣⲉⲧⲉⲛϣⲁⲛϣⲉ ⲛⲱⲧⲉⲛ ⲉ̀ϧⲟⲩⲛ ⲉ̀ⲡⲓⲙⲱⲟⲩ ⲛ̀ⲧⲉ ⲡⲓⲓⲟⲣⲇⲁⲛⲏⲥ ⲧⲉⲧⲉⲛⲟϩⲓ ⲉ̀ⲣⲁⲧⲉⲛ ⲑⲏⲛⲟⲩ ϧⲉⲛ ⲡⲓⲓⲟⲣⲇⲁⲛⲏⲥ"
  },
  {
    "chapter": 3,
    "verse": 9,
    "text": "Ⲟⲩⲟϩ ⲡⲉϫⲉ ⲓⲏⲥⲟⲩ ⲛ̀ⲛⲉⲛϣⲏⲣⲓ ⲙ̀ⲡⲓⲥ̅ⲗ̅ ϫⲉ ϯ ⲙ̀ⲡⲉⲧⲉⲛⲟⲩⲟⲓ ⲙ̀ⲡⲁⲓⲙⲁ ⲉ̀ϧⲟⲩⲛ ⲉ̀ⲣⲟⲓ ⲛ̀ⲧⲉⲧⲉⲛⲥⲱⲧⲉⲙ ⲙ̀ⲡⲥⲁϫⲓ ⲙ̀ⲡ⳪̅ ⲫϯ"
  },
  {
    "chapter": 3,
    "verse": 10,
    "text": "Ϧⲉⲛ ⲫⲁⲓ ⲧⲉⲧⲉⲛⲛⲁⲉⲙⲓ ϫⲉ ⲫϯ ⲉⲧⲟⲛϧ ⲛⲉⲙⲱⲧⲉⲛ ⲟⲩⲟϩ ϧⲉⲛ ⲟⲩϥⲱϯ ⲉ̀ⲃⲟⲗ ϥⲛⲁϥⲱϯ ⲉ̀ⲃⲟⲗ ϧⲁ ⲧⲉⲧⲉⲛϩⲏ ⲙ̀ⲡⲓⲭⲁⲛⲁⲛⲉⲟⲥ ⲛⲉⲙ ⲭⲉⲧⲧⲉⲟⲥ ⲛⲉⲙ ⲫⲉⲣⲉⲍⲉⲟⲥ ⲛⲉⲙ ⲉⲩⲉⲟⲥ ⲛⲉⲙ ⲁⲙⲟⲣⲣⲉⲟⲥ ⲛⲉⲙ ⲅⲉⲣⲅⲉⲥⲉⲟⲥ ⲛⲉⲙ ⲓⲉⲃⲟⲩⲥⲉⲟⲥ"
  },
  {
    "chapter": 3,
    "verse": 11,
    "text": "Ϩⲏⲡⲡⲉ ⲓⲥ ⲛ̀ϫⲉ ϯⲕⲓⲃⲱⲧⲟⲥ ⲛ̀ⲧⲉ ϯⲇⲓⲁⲑⲏⲕⲏ ⲙ̀ⲡ⳪̅ ⲙ̀ⲡⲕⲁϩⲓ ⲧⲏⲣϥ ⲥⲉⲛⲁⲉⲣϫⲓⲛⲓⲟⲣ ⲙ̀ⲡⲓⲓⲟⲣⲇⲁⲛⲏⲥ ϩⲓ ⲧϩⲏ ⲙ̀ⲙⲱⲧⲉⲛ"
  },
  {
    "chapter": 3,
    "verse": 12,
    "text": "Ϯⲛⲟⲩ ⲇⲉ ϭⲓ ⲉ̀ⲃⲟⲗ ϧⲉⲛ ⲑⲏⲛⲟⲩ ⲙ̀ⲓ̅ⲃ̅ ⲛ̀ⲣⲱⲙⲓ ⲉ̀ⲃⲟⲗ ϧⲉⲛ ⲛⲉⲛϣⲏⲣⲓ ⲙ̀ⲡⲓⲥ̅ⲗ̅ ⲟⲩⲣⲱⲙⲓ ⲕⲁⲧⲁ ⲫⲩⲗⲏ"
  },
  {
    "chapter": 3,
    "verse": 13,
    "text": "Ⲟⲩⲟϩ ⲉⲣⲉ ⲛⲓⲟⲩⲏⲃ ⲟϩⲓ ⲉ̀ⲣⲁⲧⲟⲩ ⲛⲏ ⲉⲧϥⲁⲓ ϧⲁ ϯⲕⲓⲃⲱⲧⲟⲥ ⲛ̀ⲧⲉ ϯⲇⲓⲁⲑⲏⲕⲏ ⲙ̀ⲡ⳪̅ ⲙ̀ⲡⲕⲁϩⲓ ⲧⲏⲣϥ ϧⲉⲛ ⲫⲙⲱⲟⲩ ⲛ̀ⲧⲉ ⲡⲓⲓⲟⲣⲇⲁⲛⲏⲥ ⲛⲁⲩⲱϣⲉⲙ ⲇⲉ ⲉⲧϣⲟⲩⲱ ⲉ̀ϩⲣⲏⲓ ⲛ̀ⲁⲕⲛⲏ ⲉϥϣⲟⲩⲱ ⲉ̀ϧⲣⲏⲓ"
  },
  {
    "chapter": 3,
    "verse": 14,
    "text": "Ⲟⲩⲟϩ ⲡⲓⲗⲁⲟⲥ ⲁϥⲧⲱⲛϥ ϧⲉⲛ ⲛⲟⲩⲙⲁⲛ̀ϣⲱⲡⲓ ⲉ̀ⲑⲣⲟⲩⲉⲣϫⲓⲛⲓⲟⲣ ⲙⲡⲓⲓⲟⲣⲇⲁⲛⲏⲥ ⲛⲓⲟⲩⲏⲃ ⲇⲉ ⲁⲩⲧⲁⲗⲟ ⲉ̀ϫⲱⲟⲩ ⲛ̀ϯⲕⲓⲃⲱⲧⲟⲥ ⲛ̀ϯⲇⲓⲁⲑⲏⲕⲏ ⲙ̀ⲡ⳪̅ ϩⲓ ⲧϩⲏ ⲙ̀ⲙⲱⲟⲩ"
  },
  {
    "chapter": 3,
    "verse": 15,
    "text": "Ϧⲉⲛ ⲡϫⲓⲛⲑⲣⲟⲩⲓⲛⲓ ⲇⲉ ⲉ̀ϧⲟⲩⲛ ⲛ̀ϯⲕⲓⲃⲱⲧⲟⲥ ⲉ̀ⲡⲓⲓⲟⲣⲇⲁⲛⲏⲥ ⲛ̀ϫⲉ ⲛⲓⲟⲩⲏⲃ ⲉⲩϥⲁⲓ ϧⲁ ϯⲕⲩⲃⲱⲧⲟⲥ ⲛ̀ⲧⲉ ϯⲇⲓⲁⲑⲏⲕⲏ ⲙ̀ⲡ⳪̅ ⲁⲩϫⲟⲗⲕⲟⲩ ⲁⲩⲱⲙⲥ ⲛ̀ⲟⲩⲙⲉⲣⲟⲥ ϧⲉⲛ ⲫⲙⲱⲟⲩ ⲙ̀ⲡⲓⲓⲟⲣⲇⲁⲛⲏⲥ ⲛⲁϥⲙⲉϩ ⲇⲉ ⲙ̀ⲙⲱⲟⲩ ϣⲁ ⲛⲉϥⲥⲫⲟⲧⲟⲩ ⲙ̀ⲫⲣⲏϯ ⲛ̀ⲛⲓⲉϩⲟⲟⲩ ⲛ̀ⲧⲉ ⲡⲓⲱⲥϧ ⲛ̀ⲥⲟⲩⲟ"
  },
  {
    "chapter": 3,
    "verse": 16,
    "text": "Ⲟⲩⲟϩ ⲉⲧⲁⲩϭⲣⲟ ⲉ̀ⲙⲁϣⲱ ϣⲁ ⲉ̀ϩⲣⲏⲓ ⲉ̀ⲡⲥⲁ ⲛ̀ⲕⲁⲣⲓⲁⲑⲓⲁⲣⲓⲙ ⲙ̀ⲫⲙⲱⲟⲩ ⲉⲧϣⲟⲩⲱ ⲉ̀ϩⲣⲏⲓ ⲁϥϧⲁϯ ⲉ̀ⲃⲟⲗ ⲉ̀ⲫⲓⲟⲙ ⲛ̀ⲛⲓϩⲙⲟⲩ ϣⲁⲛⲧⲉϥⲙⲟⲩⲛⲕ ⲉ̀ⲡⲧⲏⲣϥ ⲟⲩⲟϩ ⲡⲓⲗⲁⲟⲥ ⲛⲁϥⲟϩⲓ ⲉ̀ⲣⲁⲧϥ ⲙ̀ⲡⲉⲙ̀ⲑⲟ ⲛ̀ⲓⲉⲣⲓⲭⲱ"
  },
  {
    "chapter": 3,
    "verse": 17,
    "text": "Ⲟⲩⲟϩ ⲛⲓⲟⲩⲏⲃ ⲉⲧϥⲁⲓ ϧⲁ ϯⲕⲓⲃⲱⲧⲟⲥ ⲛ̀ϯⲇⲓⲁⲑⲏⲕⲏ ⲙ̀ⲡ⳪̅ ⲟϩⲓ ⲉ̀ⲣⲁⲧⲟⲩ ϩⲓϫⲉⲛ ⲛⲏ ⲉⲧϣⲟⲩⲱ ϧⲉⲛ ⲑⲙⲏϯ ⲙ̀ⲡⲓⲓⲟⲣⲇⲁⲛⲏⲥ ⲟⲩⲟϩ ⲛⲉⲛϣⲏⲣⲓ ⲙ̀ⲡⲓⲥ̅ⲗ̅ ⲉ̀ϫⲉⲛ ⲓⲟⲣ ⲁⲩⲙⲟϣⲓ ϧⲉⲛ ⲡⲉⲧϣⲟⲩⲱ ϣⲁⲛⲧⲉ ⲡⲓⲗⲁⲟⲥ ⲉⲣϫⲓⲛⲓⲟⲣ ⲙ̀ⲡⲓⲓⲟⲣⲇⲁⲛⲏⲥ"
  },
  {
    "chapter": 4,
    "verse": 1,
    "text": "Ⲡ⳪̅ ⲇⲉ ⲁϥⲥⲁϫⲓ ⲛⲉⲙ ⲓⲏⲥⲟⲩ ⲉϥϫⲱ ⲙ̀ⲙⲟⲥ ⲙⲉⲛⲉⲛⲥⲁ ⲑⲣⲉ ⲡⲓⲗⲁⲟⲥ ⲧⲏⲣϥ ⲉϥϫⲓⲛⲓⲟⲣ ⲙ̀ⲡⲓⲓⲟⲣⲇⲁⲛⲏⲥ"
  },
  {
    "chapter": 4,
    "verse": 2,
    "text": "Ϫⲉ ϭⲓ ⲛ̀ϩⲁⲛⲣⲱⲙⲓ ⲉ̀ⲃⲟⲗ ϧⲉⲛ ⲡⲓⲗⲁⲟⲥ ⲟⲩⲣⲱⲙⲓ ⲕⲁⲧⲁ ⲫⲩⲗⲏ"
  },
  {
    "chapter": 4,
    "verse": 3,
    "text": "Ⲛ̀ⲧⲉⲕϩⲟⲛϩⲉⲛ ⲛ̀ⲧⲟⲧⲟⲩ ⲛ̀ⲥⲉⲱⲗⲓ ⲉ̀ⲃⲟⲗ ϧⲉⲛ ⲡⲓⲙⲁ ϧⲉⲛ ⲑⲙⲏϯ ⲙ̀ⲡⲓⲓⲟⲣⲇⲁⲛⲏⲥ ⲙ̀ⲡⲓⲓ̅ⲃ̅ ⲛ̀ⲱⲛⲓ ⲉⲩⲟⲩⲟϫ ⲟⲩⲟϩ ⲛⲁⲓ ⲙⲁⲣⲟⲩⲭⲁⲩ ⲛ̀ϧⲣⲏⲓ ϩⲓ ⲟⲩⲥⲟⲡ ϧⲉⲛ ⲛⲉⲧⲉⲛⲙⲁⲛ̀ϣⲱⲡⲓ ⲙ̀ⲡⲕⲱϯ"
  },
  {
    "chapter": 4,
    "verse": 4,
    "text": "Ⲟⲩⲟϩ ϧⲉⲛ ⲡϫⲓⲛⲑⲣⲉ ⲓⲏⲥⲟⲩ ⲙⲟⲩϯ ⲙ̀ⲡⲓⲓⲃ ⲛ̀ⲣⲱⲙⲓ ⲉ̀ⲃⲟⲗ ϧⲉⲛ ⲛⲏ ⲉⲧⲟⲓ ⲛ̀ⲛⲉⲛϣⲏⲣⲓ ⲙ̀ⲡⲓⲥ̅ⲗ̅ ⲟⲩⲣⲱⲙⲓ ⲕⲁⲧⲁ ⲫⲩⲗⲏ"
  },
  {
    "chapter": 4,
    "verse": 5,
    "text": "Ⲁϥⲥⲁϫⲓ ⲛⲉⲙⲱⲟⲩ ⲉϥϫⲱ ⲙ̀ⲙⲟⲥ ϫⲉ ϯ ⲙ̀ⲡⲉⲧⲉⲛⲟⲩⲟⲓ ϩⲓⲧϩⲏ ⲙ̀ⲙⲟⲓ ⲙ̀ⲡⲉⲙ̀ⲑⲟ ⲉ̀ⲃⲟⲗ ⲙ̀ⲡ⳪̅ ϧⲉⲛ ⲑⲙⲏϯ ⲙ̀ⲡⲓⲓⲟⲣⲇⲁⲛⲏⲥ ⲟⲩⲟϩ ⲙⲁⲣⲉ ⲡⲓⲟⲩⲁⲓ ⲙ̀ⲙⲱⲧⲉⲛ ϭⲓ ⲉ̀ⲃⲟⲗ ϧⲉⲛ ⲡⲓⲙⲁ ⲉⲧⲉⲙ̀ⲙⲁⲩ ⲛ̀ⲟⲩⲱⲛⲓ ⲛ̀ⲧⲉϥⲧⲁⲗⲟϥ ⲉ̀ϫⲉⲛ ⲧⲉϥⲛⲁϩⲃⲓ ⲕⲁⲧⲁ ⲧⲓ̅ⲃ̅ ⲙ̀ⲫⲩⲗⲏ ⲛ̀ⲧⲉ ⲡⲓⲥ̅ⲗ̅"
  },
  {
    "chapter": 4,
    "verse": 6,
    "text": "Ϫⲉ ϩⲓⲛⲁ ⲛ̀ⲧⲉ ⲛⲁⲓ ϣⲱⲡⲓ ⲛⲱⲧⲉⲛ ⲉⲩⲙⲏⲓⲛⲓ ⲉϥⲭⲏ ⲉ̀ϧⲣⲏⲓ ⲛ̀ⲥⲏⲟⲩ ⲛⲓⲃⲉⲛ ϫⲉ ϩⲓⲛⲁ ⲁϥϣⲁⲛϣⲉⲛⲕ ⲛ̀ⲣⲁⲥϯ ⲛ̀ϫⲉ ⲡⲉⲕϣⲏⲣⲓ ⲉϥϫⲱ ⲙ̀ⲙⲟⲥ ϫⲉ ⲟⲩ ⲛⲉ ⲛⲁⲓⲱⲛⲓ ⲉⲧⲭⲏ ⲉ̀ϧⲣⲏⲓ ⲛⲱⲧⲉⲛ"
  },
  {
    "chapter": 4,
    "verse": 7,
    "text": "Ⲛ̀ⲑⲟⲕ ϩⲱⲕ ⲉⲕⲉ̀ⲉⲣⲟⲩⲱ ⲙ̀ⲡⲉⲕϣⲏⲣⲓ ⲉⲕϫⲱ ⲙ̀ⲙⲟⲥ ⲛⲁϥ ϫⲉ ⲉⲑⲃⲉ ϫⲉ ⲁϥⲙⲟⲩⲛⲕ ⲛ̀ϫⲉ ⲡⲓⲓⲟⲣⲇⲁⲛⲏⲥ ⲛⲓⲁⲣⲟ ϧⲁⲧϩⲏ ⲛ̀ϯⲕⲩⲃⲱⲧⲟⲥ ⲛ̀ϯⲇⲓⲁⲑⲏⲕⲏ ⲙ̀ⲡ⳪̅ ⲙ̀ⲡⲕⲁϩⲓ ⲧⲏⲣϥ ⲉ̀ⲑⲣⲉⲥϫⲓⲛⲓⲟⲣ ⲙ̀ⲙⲟϥ ⲟⲩⲟϩ ⲛⲁⲓⲱⲛⲓ ⲉⲩⲉ̀ϣⲱⲡⲓ ⲛⲱⲧⲉⲛ ⲛ̀ⲟⲩⲉⲣⲫⲙⲉⲩⲓ ϧⲉⲛ ⲛⲉⲛϣⲏⲣⲓ ⲙ̀ⲡⲓⲥ̅ⲗ̅ ϣⲁ ⲉⲛⲉϩ"
  },
  {
    "chapter": 4,
    "verse": 8,
    "text": "Ⲟⲩⲟϩ ⲁⲩⲓⲣⲓ ⲛϫ̀ⲉ ⲛⲉⲛϣⲏⲣⲓ ⲙ̀ⲡⲓⲥ̅ⲗ̅ ⲕⲁⲧⲁ ⲫⲣⲏϯ ⲉⲧⲁϥϩⲟⲛϩⲉⲛ ⲛ̀ⲧⲟⲧϥ ⲛ̀ⲓⲏⲥⲟⲩ ⲟⲩⲟϩ ϧⲉⲛ ⲡϫⲓⲛⲑⲣⲟⲩⲱⲗⲓ ⲙ̀ⲡⲓ̅ⲃ̅ ⲛ̀ⲱⲛⲓ ⲉ̀ⲃⲟⲗ ϧⲉⲛ ⲑⲙⲏϯ ⲙⲡⲓⲓⲟⲣⲇⲁⲛⲏⲥ ⲕⲁⲧⲁ ⲫⲣⲏϯ ⲉⲧⲁ ⲡ⳪̅ ϩⲟⲛϩⲉⲛ ⲉ̀ⲧⲟⲧϥ ⲛ̀ⲓⲏⲥⲟⲩ ϧⲉⲛ ⲡϫⲓⲛⲑⲣⲟⲩⲕⲏⲛ ⲇⲉ ⲉⲩⲉⲣϫⲓⲛⲓⲟⲣ ⲧⲏⲣⲟⲩ ⲛ̀ϫⲉ ⲛⲉⲛϣⲏⲣⲓ ⲙ̀ⲡⲓⲥ̅ⲗ̅ ⲉⲩⲱⲗⲓ ⲙ̀ⲙⲱⲟⲩ ⲛⲉⲙⲱⲟⲩ ⲉ̀ϩⲣⲏⲓ ⲉⲧⲟⲩⲡⲁⲣⲉⲙⲃⲟⲗⲏ ⲁⲩⲭⲁⲩ ϧⲉⲛ ⲡⲓⲙⲁ ⲉⲧⲉⲙ̀ⲙⲁⲩ"
  },
  {
    "chapter": 4,
    "verse": 9,
    "text": "Ⲓⲏⲥⲟⲩ ⲇⲉ ⲁϥⲧⲁϩⲟ ⲉ̀ⲣⲁⲧⲟⲩ ⲛ̀ⲕⲉⲓ̅ⲃ̅ ⲛ̀ⲱⲛⲓ ϧⲉⲛ ⲡⲓⲙⲁ ⲉⲧⲟⲩⲙⲟⲩϯ ⲉ̀ⲣⲟϥ ϫⲉ ⲭⲁⲧⲟⲩ ⲛ̀ⲛⲓϭⲁⲗⲁⲩϫ ⲛ̀ⲛⲓⲟⲩⲏⲛ ⲛⲏ ⲉⲧϥⲁⲓ ϧⲁ ϯⲕⲩⲃⲱⲧⲟⲥ ⲛ̀ϯⲇⲓⲁⲑⲏⲕⲏ ⲙ̀ⲡ⳪̅ ⲟⲩⲟϩ ⲥⲉⲭⲏ ⲉ̀ϧⲣⲏⲓ ϧⲉⲛ ⲡⲓⲙⲁ ⲉⲧⲉⲙ̀ⲙⲁⲩ ϣⲁ ⲉ̀ϧⲣⲏⲓ ⲉ̀ⲫⲟⲟⲩ ⲛ̀ⲉϩⲟⲟⲩ"
  },
